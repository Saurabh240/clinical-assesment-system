# .env.staging
# ============================================================
#  RxPrescribe Staging — Environment Variables Template
#  Copy this file to .env.staging, fill in real values,
#  and NEVER commit .env.staging to source control.
#  Add .env.staging to .gitignore immediately.
# ============================================================

# ── Database (use your managed DB URL for staging) ───────────
SPRING_DATASOURCE_URL=jdbc:postgresql://<DB_HOST>:5432/clinic
SPRING_DATASOURCE_USERNAME=clinic
SPRING_DATASOURCE_PASSWORD=<CHANGE_ME>

# ── JWT secrets (generate with: openssl rand -base64 32) ─────
JWT_ACCESS_SECRET=<CHANGE_ME_32_CHARS_MIN>
JWT_REFRESH_SECRET=<CHANGE_ME_32_CHARS_MIN_DIFFERENT>

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://staging.rxprescribe.com

# ── PDF ──────────────────────────────────────────────────────
PDF_BASE_URL=https://staging.rxprescribe.com

# ── Stripe (use TEST keys for staging) ───────────────────────
STRIPE_SECRET_KEY=sk_test_<YOUR_TEST_KEY>
STRIPE_PUBLISHABLE_KEY=pk_test_<YOUR_TEST_KEY>
STRIPE_WEBHOOK_SECRET=whsec_<YOUR_TEST_WEBHOOK_SECRET>
STRIPE_PRICE_MONTHLY=price_<YOUR_TEST_MONTHLY_PRICE_ID>
STRIPE_PRICE_ANNUAL=price_<YOUR_TEST_ANNUAL_PRICE_ID>
STRIPE_SUCCESS_URL=https://staging.rxprescribe.com/success
STRIPE_CANCEL_URL=https://staging.rxprescribe.com/cancel
